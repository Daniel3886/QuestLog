generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String    @unique
  password        String
  bio             String?
  avatar          String    @default("🧙")
  isBanned        Boolean   @default(false) @map("is_banned")
  bannedReason    String?   @map("banned_reason")
  bannedAt        DateTime? @map("banned_at")
  coins           Int       @default(0)
  /// Total lifetime XP (level is derived: floor(xp/100), min 1).
  xp              Int       @default(0)
  level           Int       @default(1)
  streak          Int       @default(0)
  weekStreak      Int       @default(0) @map("week_streak")
  activeDays      Int       @default(0) @map("active_days")
  questsCompleted Int       @default(0) @map("quests_completed")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  quests           Quest[]         @relation("QuestCreator")
  questLogs        QuestLog[]      @relation("QuestLogger")
  personalQuests   PersonalQuest[]
  guildMemberships GuildMember[]
  participations   Participation[]
  comments         Comment[]
  reports          Report[]
  bugReports       BugReport[]
  friendsInitiated Friend[]        @relation("FriendInitiator")
  friendsReceived  Friend[]        @relation("FriendReceiver")

  @@map("users")
}

model Quest {
  id            String             @id @default(uuid())
  creatorId     String             @map("creator_id")
  title         String
  description   String?
  icon          String             @default("⚔️")
  type          QuestType          @default(PERSONAL)
  trackingType  QuestTrackingType  @default(NUMERIC) @map("tracking_type")
  targetValue   Float              @default(1) @map("target_value")
  unit          String?
  proofRequired QuestProofRequired @default(NONE) @map("proof_required")
  frequency     QuestFrequency     @default(DAILY)
  category      QuestCategory?
  difficulty    QuestDifficulty?
  averageRating Float              @default(0) @map("average_rating")
  ratingCount   Int                @default(0) @map("rating_count")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  creator        User            @relation("QuestCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  logs           QuestLog[]
  personalQuests PersonalQuest[]
  guildQuests    GuildQuest[]

  @@index([creatorId])
  @@index([type])
  @@index([category])
  @@map("quests")
}

model PersonalQuest {
  id           String              @id @default(uuid())
  userId       String              @map("user_id")
  questId      String              @map("quest_id")
  status       PersonalQuestStatus @default(ACTIVE)
  currentValue Float               @default(0) @map("current_value")
  repetitive   Boolean             @default(false)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId])
  @@map("personal_quests")
}

model QuestLog {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  questId      String       @map("quest_id")
  logDate      DateTime     @map("log_date") @db.Date
  currentValue Float        @default(0) @map("current_value")
  rating       QuestRating?
  note         String?
  proofUrl     String?      @map("proof_url")
  loggedAt     DateTime     @default(now()) @map("logged_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  user  User  @relation("QuestLogger", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questId, logDate])
  @@index([userId])
  @@index([questId])
  @@index([loggedAt])
  @@map("quest_logs")
}

model Guild {
  id          String   @id @default(uuid())
  name        String
  description String?
  avatar      String   @default("⚔️")
  gems        Int      @default(0)
  level       Int      @default(1)
  xp          Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  members     GuildMember[]
  guildQuests GuildQuest[]

  @@map("guilds")
}

model GuildMember {
  id           String          @id @default(uuid())
  guildId      String          @map("guild_id")
  userId       String          @map("user_id")
  role         GuildMemberRole @default(MEMBER)
  contribution Int             @default(0)
  joinedAt     DateTime        @default(now()) @map("joined_at")

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([userId])
  @@map("guild_members")
}

model GuildQuest {
  id           String           @id @default(uuid())
  guildId      String           @map("guild_id")
  questId      String           @map("quest_id")
  questType    GuildQuestType   @default(SUMMATIVE) @map("quest_type")
  status       GuildQuestStatus @default(DRAFTING)
  votes        Int              @default(0)
  currentValue Float            @default(0) @map("current_value")
  startDate    DateTime?        @map("start_date")
  endDate      DateTime?        @map("end_date")
  rewardGems   Int              @default(0) @map("reward_gems")
  rewardItemId String?          @map("reward_item_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  guild      Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  quest      Quest @relation(fields: [questId], references: [id], onDelete: Cascade)
  rewardItem Item? @relation(fields: [rewardItemId], references: [id], onDelete: SetNull)

  @@index([guildId])
  @@index([status])
  @@map("guild_quests")
}

model Event {
  id           String   @id @default(uuid())
  title        String
  description  String?
  icon         String   @default("🌍")
  targetValue  Float    @map("target_value")
  currentValue Float    @default(0) @map("current_value")
  unit         String?
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  rewardCoins  Int      @default(0) @map("reward_coins")
  rewardXp     Int      @default(0) @map("reward_xp")
  rewardItemId String?  @map("reward_item_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  participations Participation[]
  rewardItem     Item?           @relation(fields: [rewardItemId], references: [id], onDelete: SetNull)

  @@index([endDate])
  @@map("events")
}

model Participation {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  eventId        String   @map("event_id")
  contribution   Float    @default(0)
  rewardsClaimed Boolean  @default(false) @map("rewards_claimed")
  joinedAt       DateTime @default(now()) @map("joined_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("participations")
}

model Comment {
  id         String            @id @default(uuid())
  userId     String            @map("user_id")
  targetType CommentTargetType @map("target_type")
  targetId   String            @map("target_id")
  content    String
  reported   Boolean           @default(false)
  createdAt  DateTime          @default(now()) @map("created_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([userId])
  @@map("comments")
}

model Report {
  id           String       @id @default(uuid())
  userId       String       @map("user_id")
  reportedType ReportedType @map("reported_type")
  reportedId   String       @map("reported_id")
  content      String?
  createdAt    DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([reportedType, reportedId])
  @@map("reports")
}

model BugReport {
  id          String   @id @default(uuid())
  userId      String
  description String   @db.Text
  status      String   @default("new")
  answer      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Admin {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

model Friend {
  id        String       @id @default(uuid())
  userId    String       @map("user_id")
  friendId  String       @map("friend_id")
  status    FriendStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  user   User @relation("FriendInitiator", fields: [userId], references: [id], onDelete: Cascade)
  friend User @relation("FriendReceiver", fields: [friendId], references: [id], onDelete: Cascade)

  @@unique([userId, friendId])
  @@index([friendId])
  @@map("friends")
}

model Item {
  id          String   @id @default(uuid())
  name        String
  description String?
  priceCoins  Int      @default(0) @map("price_coins")
  priceGems   Int      @default(0) @map("price_gems")
  type        ItemType @default(BADGE)
  icon        String   @default("🏅")
  fileUrl     String?  @map("file_url")
  createdAt   DateTime @default(now()) @map("created_at")

  inventory   Inventory[]
  guildQuests GuildQuest[]
  events      Event[]

  @@map("items")
}

model Inventory {
  id        String    @id @default(uuid())
  ownerId   String    @map("owner_id")
  ownerType OwnerType @map("owner_type")
  itemId    String    @map("item_id")
  active    Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([ownerId, ownerType])
  @@map("inventory")
}

enum QuestType {
  PERSONAL
  GUILD
  PUBLIC
}

enum QuestFrequency {
  DAILY
  WEEKLY
  CUSTOM
}

enum QuestTrackingType {
  BINARY
  NUMERIC
  TIMER
}

enum QuestProofRequired {
  NONE
  IMAGE
  TEXT
}

enum QuestRating {
  ENERGIZED
  OKAY
  SLOG
}

enum QuestCategory {
  FITNESS
  EDUCATION
  CREATIVITY
  WELLNESS
  OTHER
}

enum QuestDifficulty {
  EASY
  MEDIUM
  HARD
}

enum PersonalQuestStatus {
  ACTIVE
  COMPLETED
  FAILED
}

enum GuildMemberRole {
  LEADER
  MEMBER
}

enum GuildQuestStatus {
  DRAFTING
  ACTIVE
  COMPLETED
  FAILED
}

enum GuildQuestType {
  SUMMATIVE
  CONCURRENT
  STREAK
}

enum CommentTargetType {
  EVENT
  QUEST
  GUILD
  GUILD_QUEST
  TAVERN
}

enum ReportedType {
  USER
  COMMENT
  QUEST
  GUILD_QUEST
}

enum FriendStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum ItemType {
  BADGE
  AVATAR
  COSMETIC
}

enum OwnerType {
  USER
  GUILD
}
